{
	"name": "nh-deck",
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"description": "A local-first CLI tool for writing, presenting, and exporting Markdown-based slide decks.",
	"bin": {
		"nh-deck": "dist/index.js"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && node scripts/typecheck-tests.mjs",
		"lint": "biome ci .",
		"check:fidelity": "node --import tsx scripts/check-pdf-fidelity.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sairam0424/nh-deck.git"
	},
	"bugs": {
		"url": "https://github.com/sairam0424/nh-deck/issues"
	},
	"homepage": "https://github.com/sairam0424/nh-deck#readme",
	"dependencies": {
		"beautiful-mermaid": "^1.1.3",
		"chrome-launcher": "^1.1.2",
		"commander": "^15.0.0",
		"katex": "^0.18.7",
		"marked": "^13.0.3",
		"marked-katex-extension": "^5.1.12",
		"open": "^11.0.2",
		"puppeteer-core": "^25.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^26.5.0",
		"pngjs": "^7.0.0",
		"tsx": "^4.19.1",
		"typescript": "^5.6.3",
		"vitest": "^5.0.0"
	}
}
