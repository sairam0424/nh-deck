{
	"name": "nh-deck",
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"description": "A local-first CLI tool for writing, presenting, and exporting Markdown-based slide decks.",
	"bin": {
		"nh-deck": "dist/index.js"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && node scripts/typecheck-tests.mjs",
		"lint": "biome ci ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sairam0424/nh-deck.git"
	},
	"bugs": {
		"url": "https://github.com/sairam0424/nh-deck/issues"
	},
	"homepage": "https://github.com/sairam0424/nh-deck#readme",
	"dependencies": {
		"beautiful-mermaid": "^1.1.3",
		"chrome-launcher": "^1.1.2",
		"commander": "^12.1.0",
		"marked": "^13.0.3",
		"open": "^10.1.0",
		"puppeteer-core": "^25.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^20.14.0",
		"tsx": "^4.19.1",
		"typescript": "^5.6.3",
		"vitest": "^2.1.3"
	}
}
